{
  "name": "pi-extensions-workspace",
  "private": true,
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "description": "Bun workspace for independently published Pi extensions",
  "type": "module",
  "workspaces": [
    "extensions/background-tasks",
    "extensions/codex-api",
    "extensions/cursor-effect",
    "extensions/pwsh-adapter",
    "extensions/thinking-fold",
    "extensions/todo",
    "packages/shared-settings"
  ],
  "scripts": {
    "test": "node --import tsx --test --test-isolation=process tests/background-tasks.test.ts tests/codex-api.test.ts tests/cursor-effect.test.ts tests/shared-settings.test.ts tests/thinking-fold.test.ts tests/todo.test.ts tests/packages.test.ts",
    "lint": "tsc --noEmit",
    "check": "bun run lint && bun run test",
    "pack:background-tasks": "bun pm pack --dry-run --cwd extensions/background-tasks",
    "pack:codex-api": "bun pm pack --dry-run --cwd extensions/codex-api",
    "pack:cursor-effect": "bun pm pack --dry-run --cwd extensions/cursor-effect",
    "pack:pwsh-adapter": "bun pm pack --dry-run --cwd extensions/pwsh-adapter",
    "pack:thinking-fold": "bun pm pack --dry-run --cwd extensions/thinking-fold",
    "pack:todo": "bun pm pack --dry-run --cwd extensions/todo",
    "pack:shared-settings": "bun pm pack --dry-run --cwd packages/shared-settings",
    "pack:check": "bun run check && bun run pack:shared-settings && bun run pack:background-tasks && bun run pack:codex-api && bun run pack:cursor-effect && bun run pack:pwsh-adapter && bun run pack:thinking-fold && bun run pack:todo"
  },
  "author": "99percentpeople",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/99percentpeople/pi-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/99percentpeople/pi-extensions/issues"
  },
  "homepage": "https://github.com/99percentpeople/pi-extensions#readme",
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typebox": "latest",
    "typescript": "^5.0.0"
  },
  "trustedDependencies": [
    "node-pty"
  ]
}
