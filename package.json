{
  "name": "@99percentpeople/pi-extensions",
  "version": "1.0.0",
  "description": "Custom extensions for Pi coding agent - background tasks and PowerShell adapter",
  "type": "module",
  "main": "index.js",
  "files": [
    "extensions/",
    "themes/",
    "skills/",
    "prompts/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "tsc --noEmit",
    "check": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/background-tasks/index.ts",
      "./extensions/pwsh-adapter/index.ts"
    ],
    "themes": [
      "./themes/midnight.json"
    ],
    "skills": [
      "./skills/git-workflow/SKILL.md"
    ],
    "prompts": [
      "./prompts/code-review.md"
    ]
  },
  "keywords": [
    "pi",
    "extensions",
    "coding-agent",
    "ai",
    "background-tasks",
    "powershell",
    "pwsh"
  ],
  "author": "99percentpeople",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/99percentpeople/pi-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/99percentpeople/pi-extensions/issues"
  },
  "homepage": "https://github.com/99percentpeople/pi-extensions#readme",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "typescript": "^5.0.0"
  }
}
