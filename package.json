      "./prompts/code-review.md"
    ]
  },
  "keywords": [
    "pi",
    "extensions",
    "coding-agent",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "typescript": "^5.0.0"
  }
