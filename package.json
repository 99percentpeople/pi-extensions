{
  "name": "pi-extensions",
  "version": "1.0.0",
  "description": "Custom extensions for Pi coding agent",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "tsc --noEmit",
    "check": "tsc --noEmit"
  },
  "pi": {
