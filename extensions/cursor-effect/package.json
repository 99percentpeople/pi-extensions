{
  "name": "@99percentpeople/pi-cursor-effect",
  "version": "0.1.6",
  "private": true,
  "description": "Apply selectable visual effects to Pi's main working cursor status",
  "type": "module",
  "scripts": {
    "build": "bun run ../../scripts/build-package.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "piBuild": {
    "bundlePackages": [
      "@99percentpeople/pi-shared-settings"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "cursor",
    "animation",
    "tui"
  ],
  "author": "99percentpeople",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/99percentpeople/pi-extensions.git",
    "directory": "extensions/cursor-effect"
  },
  "bugs": {
    "url": "https://github.com/99percentpeople/pi-extensions/issues"
  },
  "homepage": "https://github.com/99percentpeople/pi-extensions#cursor-effect",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@99percentpeople/pi-shared-settings": "0.1.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
