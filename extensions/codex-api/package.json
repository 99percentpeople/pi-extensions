{
  "name": "@99percentpeople/pi-codex-api",
  "version": "0.3.2",
  "private": true,
  "description": "Expose Codex subscription text, vision, image, search, Fast, and usage APIs to Pi",
  "type": "module",
  "scripts": {
    "build": "bun run ../../scripts/build-package.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "piBuild": {
    "assets": [
      "skills"
    ],
    "bundlePackages": [
      "@99percentpeople/pi-shared-settings",
      "@99percentpeople/pi-workspace-files"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "codex",
    "chatgpt",
    "multilingual",
    "second-opinion",
    "image-generation",
    "web-search"
  ],
  "author": "99percentpeople",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/99percentpeople/pi-extensions.git",
    "directory": "extensions/codex-api"
  },
  "bugs": {
    "url": "https://github.com/99percentpeople/pi-extensions/issues"
  },
  "homepage": "https://github.com/99percentpeople/pi-extensions#codex-api",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@99percentpeople/pi-shared-settings": "0.1.3",
    "@99percentpeople/pi-workspace-files": "0.1.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
