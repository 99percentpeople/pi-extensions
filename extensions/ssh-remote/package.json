{
  "name": "@99percentpeople/pi-ssh-remote",
  "version": "0.1.0",
  "description": "Route Pi's file and shell tools to remote Unix or Windows workspaces through OpenSSH",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run ../../scripts/build-package.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run --cwd ../.. check"
  },
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "ssh",
    "remote-development",
    "openssh"
  ],
  "author": "99percentpeople",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/99percentpeople/pi-extensions.git",
    "directory": "extensions/ssh-remote"
  },
  "bugs": {
    "url": "https://github.com/99percentpeople/pi-extensions/issues"
  },
  "homepage": "https://github.com/99percentpeople/pi-extensions#ssh-remote",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@99percentpeople/pi-shared-settings": "0.1.2",
    "@99percentpeople/pi-workspace-files": "0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
