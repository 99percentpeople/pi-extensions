{
  "name": "@99percentpeople/pi-shared-settings",
  "version": "0.1.2",
  "description": "Shared namespaced settings store and installed-extension menu for @99percentpeople Pi packages",
  "type": "module",
  "main": "./dist/index.ts",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run ../../scripts/build-package.ts && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "prepublishOnly": "bun run --cwd ../.. check"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "settings",
    "extension"
  ],
  "author": "99percentpeople",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/99percentpeople/pi-extensions.git",
    "directory": "packages/shared-settings"
  },
  "bugs": {
    "url": "https://github.com/99percentpeople/pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
